{
  "name": "calling-service-webapp",
  "version": "3.0.0",
  "description": "WebRTC-based calling service for Telegram and native wrappers",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test",
    "health": "node -e \"fetch('http://localhost:'+(process.env.PORT||3000)+'/health').then(r=>r.json()).then(j=>{console.log(j);process.exit(j.status==='ok'?0:1)}).catch(e=>{console.error(e.message);process.exit(1)})\"",
    "build": "echo 'No build step required'"
  },
  "keywords": [
    "webrtc",
    "calling",
    "telegram",
    "video-call",
    "voice-call"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
