# Copy to .env (or set these in your hosting provider) and adjust.
# Every value below is optional — the defaults shown are what the server uses.

# --- Runtime ---
PORT=3000
# NODE_ENV=production
# Number of proxy hops in front of the app. Defaults to 0 — set it explicitly
# when you run behind a proxy (Railway/Render: 1), or the per-IP limits key on
# the socket address and HSTS depends on the raw x-forwarded-proto header. Must
# match the infrastructure: one hop too many lets a client forge
# X-Forwarded-For and bypass those limits entirely.
# TRUST_PROXY=1
# silent | error | warn | info | debug. Per-client events are on debug.
# LOG_LEVEL=info

# --- WebSocket access ---
# Comma-separated origins allowed to open a WebSocket. Empty means "same
# origin only", which is what a normal deployment wants.
# ALLOWED_ORIGINS=
# Set to 1 to also reject upgrades with no Origin header. Native wrappers and
# non-browser clients send none, so this breaks them.
# REQUIRE_ORIGIN=0

# --- Capacity (defaults shown) ---
# MAX_PARTICIPANTS=5
# MAX_ROOMS=500
# MAX_CONNECTIONS=2000
# MAX_CONNECTIONS_PER_IP=30
# Distinct rooms one IP may touch per minute. This is what makes guessing
# 6-character room codes expensive.
# MAX_ROOMS_PER_IP_PER_MINUTE=30
# Close sockets that connect but never join a room.
# IDLE_TIMEOUT_MS=120000
# Outbound buffer per socket before it is closed as unresponsive.
# MAX_BUFFERED_BYTES=1048576

# --- ICE ---
# Comma-separated STUN servers handed to clients via GET /config
# STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# Custom TURN server for reliable connectivity behind strict NATs/firewalls.
# Credentials stay on the server and are delivered to clients via GET /config.
# TURN_SERVER_URL=turn:your-server.com:3478,turns:your-server.com:443?transport=tcp

# Preferred: ephemeral credentials. Set the same secret in coturn with
# `use-auth-secret` + `static-auth-secret`, and leave TURN_USERNAME/PASSWORD unset.
# TURN_STATIC_AUTH_SECRET=
# TURN_CREDENTIAL_TTL_SECONDS=21600

# Fallback: long-lived credentials. Anyone who fetches /config can reuse these
# as a free relay until you rotate them.
# TURN_USERNAME=username
# TURN_PASSWORD=password

# --- Cloudflare managed TURN (instead of, or alongside, your own relay) ---
# Create a TURN key at dash.cloudflare.com and paste the two values. The app
# mints short-lived credentials through their API and caches them, so a public
# /config cannot be refreshed in a loop to spend your API quota. Both this and
# your own TURN can be set at once: more candidate paths, more calls connect.
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_API_TOKEN=
# CLOUDFLARE_TURN_TTL_SECONDS=21600

# Optional: Telegram Bot Token (if integrating with Telegram bot)
# TELEGRAM_BOT_TOKEN=your_bot_token_here
